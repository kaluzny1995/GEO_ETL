# Supabase PostgreSQL credentials — copy to .env and fill in your values.
# Obtain them from the Supabase dashboard: Project → Connect → Connection string → Transaction pooler.
# See docs/configuration/supabase-credentials.md for the full walkthrough.
SUPABASE_DB_USER=postgres.<YOUR-PROJECT-REF>
SUPABASE_DB_PASSWORD=<YOUR-PASSWORD>
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
